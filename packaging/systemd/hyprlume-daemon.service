[Unit]
Description=Hyprlume desktop and local voice daemon
Documentation=https://github.com/sumerchoudhary78/hyprlume
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hyprlume daemon
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
RuntimeDirectory=hyprlume
RuntimeDirectoryMode=0700

[Install]
WantedBy=graphical-session.target
